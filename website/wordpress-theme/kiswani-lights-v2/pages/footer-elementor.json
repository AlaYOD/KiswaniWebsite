      {"id": "b1c2d3e", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"kiswani-pro-footer__word\" aria-hidden=\"true\">KISWANI</div><style>.kiswani-pro-footer{position:relative;overflow:hidden;color:#fff}.kiswani-pro-footer__rule{height:4px;background:#FFDA01}.kiswani-pro-footer__grid{display:grid;grid-template-columns:1.2fr .48fr .56fr .6fr}.kiswani-pro-footer a{color:inherit;text-decoration:none}.kiswani-pro-footer__descriptor p{display:flex;align-items:center;gap:16px;margin:0}.kiswani-pro-footer__descriptor span{display:inline-block;width:64px;height:3px;background:#FFDA01}.kiswani-pro-footer__column nav{display:grid;gap:4px}.kiswani-pro-footer__column nav a{display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid rgba(255,255,255,.07);padding:16px 0;color:#A3A7AA;font-size:14px;transition:color .2s}.kiswani-pro-footer__column nav a:hover,.kiswani-pro-footer__contact a:hover{color:#fff}.kiswani-pro-footer__column em{color:#50555B;font-size:9px;font-style:normal}.kiswani-pro-footer__contact .elementor-widget-text-editor p{margin:0 0 16px}.kiswani-pro-footer__bottom .elementor-widget-text-editor p{margin:0;text-transform:uppercase}.kiswani-pro-footer__bottom .elementor-widget-text-editor:last-child p{display:flex;flex-wrap:wrap;justify-content:end;gap:20px}.kiswani-pro-footer__word{pointer-events:none;position:absolute;bottom:-48px;left:50%;transform:translateX(-50%);white-space:nowrap;color:rgba(255,255,255,.018);font-size:15vw;font-weight:700;line-height:1;letter-spacing:-.08em}@media(max-width:1024px){.kiswani-pro-footer__grid{grid-template-columns:1fr 1fr}.kiswani-pro-footer__brand{grid-column:1/-1}}@media(max-width:767px){.kiswani-pro-footer__grid{grid-template-columns:1fr}.kiswani-pro-footer__brand{grid-column:auto}.kiswani-pro-footer__bottom .elementor-widget-text-editor:last-child p{justify-content:start}}</style>"}, "elements": []}
