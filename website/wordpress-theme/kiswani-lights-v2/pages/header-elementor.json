              "html": "<!-- Native Nav Menu handles navigation and its hamburger toggle. Elementor Pro settings do not provide the source drawer's start-edge slide direction or overlay. This scoped hook is reserved for the small custom controller that adds those behaviors. --><style>.kiswani-pro-header{box-shadow:0 12px 34px rgba(0,0,0,.18)}.kiswani-pro-header .elementor-widget-text-editor p{margin:0;display:flex;align-items:center;justify-content:center;gap:12px;text-transform:uppercase}.kiswani-pro-header .elementor-widget-text-editor a{color:inherit;text-decoration:none}.kiswani-pro-header__search{width:min(100%,520px)}.kiswani-pro-header__cart{display:flex;width:44px;height:44px;align-items:center;justify-content:center;gap:3px;border:1px solid rgba(255,255,255,.25);color:#fff;text-decoration:none}.kiswani-pro-header__cart svg{width:18px;fill:none;stroke:currentColor;stroke-width:1.7}.kiswani-pro-header__cart span{font-size:10px;color:#FFDA01}@media (max-width:1279px){.kiswani-pro-header__search,.kiswani-pro-header__actions .elementor-widget-button{display:none}.kiswani-pro-header__navigation .elementor-menu-toggle{border:1px solid rgba(15,24,34,.18);padding:12px}.kiswani-pro-header__navigation .elementor-nav-menu--dropdown{position:fixed!important;inset:0 auto 0 0;width:min(92vw,430px);min-height:100vh;padding:72px 20px 24px;background:#fff;box-shadow:18px 0 55px rgba(0,0,0,.25)}html[dir=\"rtl\"] .kiswani-pro-header__navigation .elementor-nav-menu--dropdown{inset:0 0 0 auto;box-shadow:-18px 0 55px rgba(0,0,0,.25)}}@media (max-width:767px){.kiswani-pro-header__utility .kiswani-pro-header__email{display:none}.kiswani-pro-header__logo img{max-width:154px}}</style>"
